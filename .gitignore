# Credentials never enter git. Committing one is an automatic deduction under the
# capstone brief, and a secret in history stays there after the file is deleted.
.env
secrets.env

# Downloaded measurements. These are versioned with DVC, not with git — a 6-month
# history of hourly readings is far too large for a repository.
data/raw/
data/bank/*.csv
data/interim/
*.parquet

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
reports/pdf/
reports/bank-model.joblib
mlflow.db
mlruns/
mlartifacts/
data/bank/call-lists/
data/bank/demo/

# Working documents kept out of the repository on purpose: design notes, the
# glossary, the proposal drafts and the demo runbook are ours rather than
# deliverables, and the fonts are only needed to re-render them locally.
docs/
