# Nothing in this project needs a secret. The dataset comes from a public UCI
# archive over HTTPS, and the cloud jobs authenticate as a service account that
# Vertex AI attaches to the container at run time, so there is no key to paste
# anywhere and no credential to keep out of git.
#
# These three are the only environment variables the code reads. All of them have
# defaults in src/bank/cloud.py, so the project runs without this file. Override
# them to point the same image at a different bucket or project.

CAPSTONE_PROJECT=itcs355-6688010
CAPSTONE_BUCKET=itcs355-6688010
CAPSTONE_PREFIX=capstone
